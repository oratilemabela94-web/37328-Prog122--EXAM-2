public interface IProduct {
    int GetTotalProductsSold();
    double GetAverageProductSold();
    String GetMostPopularProduct();
}
package salesreport;


public class Product implements IProduct {

    
    private String[] productNames;

  ])
    private int[][] sales;
]
    public Product(String[] productNames, int[][] sales) {
        this.productNames = productNames;
        this.sales = sales;
    }
]
    Override
    public int GetTotalProductsSold() {
        int total = 0;
        for (int p = 0; p < sales.length; p++) {
            for (int m = 0; m < sales[p].length; m++) { 
                total = total + sales[p][m];
            }
        }
        return total;
    }


    Override
    public double GetAverageProductSold() {
        int count = 0;
        for (int p = 0; p < sales.length; p++) {
            count = count + sales[p].length;
        }
        if (count == 0) {
            return 0;  
        }
        return (double) GetTotalProductsSold() / count;   
    }

    
    Override
    public String GetMostPopularProduct() {
        int highest = -1;
        String bestName = "";
        for (int p = 0; p < sales.length; p++) {
            for (int m = 0; m < sales[p].length; m++) {
                if (sales[p][m] > highest) {     
                    highest = sales[p][m];
                    bestName = productNames[p]; 
                }
            }
        }
        return bestName + "(" + highest + ")";  
    }
}
