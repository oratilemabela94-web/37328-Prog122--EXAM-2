
public class ProductApp extends JFrame {

    private JTextField txtCustomerName = new JTextField();
    private JComboBox<String> cmbProduct = new JComboBox<>(new String[] {
        "Cozy Nights Monarch", "Restonic Barbados", "Sealy Phuket"   
    });
    private JTextField txtPrice = new JTextField();
    private JButton btnProcess = new JButton("PROCESS");

    public ProductApp() {
        setTitle("Product App");
        setSize(400, 250);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);     

        setLayout(new GridLayout(4, 2, 5, 5));
        add(new JLabel("Customer Name:"));
        add(txtCustomerName);
        add(new JLabel("Select Product:"));
        add(cmbProduct);
        add(new JLabel("Enter Price:"));
        add(txtPrice);
        add(new JLabel(""));            
        add(btnProcess);

       
        JMenuBar menuBar = new JMenuBar();

        JMenu fileMenu = new JMenu("File");
        JMenuItem exitItem = new JMenuItem("Exit");
        fileMenu.add(exitItem);

        JMenu toolsMenu = new JMenu("Tools");
        JMenuItem processItem = new JMenuItem("Process");
        JMenuItem clearItem = new JMenuItem("Clear");
        toolsMenu.add(processItem);
        toolsMenu.add(clearItem);

        menuBar.add(fileMenu);
        menuBar.add(toolsMenu);
        setJMenuBar(menuBar);

        
        btnProcess.addActionListener(e -> ProcessSale());   
        processItem.addActionListener(e -> ProcessSale());   
        clearItem.addActionListener(e -> ClearForm());
        exitItem.addActionListener(e -> System.exit(0));
    }

 
    private void ProcessSale() {
        String customerName = txtCustomerName.getText().trim();
        String product = (String) cmbProduct.getSelectedItem();

    
        if (customerName.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please enter the customer name.");
            return;
        }

        
        double price;
        try {
            price = Double.parseDouble(txtPrice.getText().trim());
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Please enter a valid price, for example 3500.");
            return;
        }

      
        ProductCalculations calc = new ProductCalculations(price);
        double vat = calc.GetVat();
        double commission = calc.GetCommission();
        double total = calc.GetTotal();

        
        String details = "Customer Name: " + customerName + "\n"
                       + "Product: " + product + "\n"
                       + "VAT: R " + vat + "\n"
                       + "COMMISSION: R " + commission + "\n"
                       + "TOTAL: R " + total;

        JOptionPane.showMessageDialog(this, details);  
        SaveToFile(details);
    }


    private void SaveToFile(String details) {
        try (PrintWriter writer = new PrintWriter(new FileWriter("data.txt", true))) {
            writer.println("DATA LOG");
            writer.println("*****************************");
            writer.println(details);
            writer.println("*****************************");
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this, "Could not save to data.txt");
        }
    }

    
    private void ClearForm() {
        txtCustomerName.setText("");
        txtPrice.setText("");
        cmbProduct.setSelectedIndex(0);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new ProductApp().setVisible(true));
    }
}
public interface IProductCalculations {
    double GetVat();
    double GetCommission();
    double GetTotal();
}
package productapp;


public class ProductCalculations implements IProductCalculations {

    private double price; 
    public ProductCalculations(double price) {
        this.price = price;
    }

   
    Override
    public double GetVat() {
        return price * 0.15;
    }

   
    Override
    public double GetCommission() {
        return price * 0.05;
    }

    Override
    public double GetTotal() {
        return price + GetVat() + GetCommission();
    }
}

